{
  "name": "bet62-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "worker": "node scripts/odds-proxy.mjs",
    "worker:wrangler": "node scripts/gen-dev-vars.mjs && wrangler dev src/worker/index.ts --remote --port 8080",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env production",
    "import": "curl.exe -X POST http://127.0.0.1:8788/api/dev/force-import -H \"Authorization: Bearer dev-admin-token\"",
    "smoke": "node scripts/smoke.js",
    "e2e": "node scripts/e2e-flow.js",
    "smoke:watch": "node scripts/smoke-watch.js",
    "generate:countries": "node scripts/generateCountries.js"
  },
